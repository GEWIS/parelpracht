{
  "name": "parelpracht-server",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently \"nodemon\" \"nodemon -x npx tsoa spec-and-routes\"",
    "build": "yarn tsoa && tsc",
    "start": "node dist/src/index.js",
    "tsoa": "tsoa spec-and-routes",
    "test": "yarn tsoa && vitest run",
    "test:watch": "vitest",
    "test:coverage": "yarn tsoa && vitest run --coverage",
    "gen-client": "nswag openapi2tsclient /input:src/public/swagger.json /output:../parelpracht-client/src/clients/server.generated.ts /ServiceHost:.",
    "db:diagram": "typeorm-uml ormconfig.json",
    "db:validate": "ts-node src/dbvalidator/validate.ts",
    "lint": "yarn tsoa && eslint src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path .gitignore --check .",
    "format:fix": "prettier --ignore-path .gitignore --write ."
  },
  "author": "The 39th board & Applicatie Beheer Commissie of Study Association GEWIS",
  "dependencies": {
    "axios": "^1.11.0",
    "body-parser": "^2.2.0",
    "connect-typeorm": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "lodash": "^4.17.21",
    "method-override": "^3.0.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "node-latex": "^3.1.0",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-ldapauth": "^3.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "sqlite3": "^5.1.7",
    "strong-error-handler": "^5.0.21",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "typeorm": "^0.3.25",
    "uuid": "^11.1.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@gewis/eslint-config-typescript": "^2.4.0",
    "@gewis/prettier-config": "^2.2.2",
    "@swc/core": "^1.15.41",
    "@testcontainers/mariadb": "^12.0.3",
    "@types/axios": "^0.14.4",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/method-override": "3.0.0",
    "@types/mime": "^3.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
